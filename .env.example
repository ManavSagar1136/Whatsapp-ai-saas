# --- Backend Configuration ---
# Generate these via respective dashboards

# 1. Supabase (Database & Next.js Auth Storage)
# Essential for RLS logic and JSON parsing
SUPABASE_URL=https://<your_supabase_project_id>.supabase.co
SUPABASE_KEY=<your_supabase_service_role_key_for_fastapi>

# 2. Redis Cache & Celery Queues (Upstash suggested)
REDIS_URL=rediss://default:<upstash_password>@<upstash_host>:6379

# 3. LLM AI Interface (Groq)
GROQ_API_KEY=gsk_<your_groq_api_key_goes_here>

# 4. Meta Webhook Security & WhatsApp Graph
# Token needed to physically POST api messages downstream
WHATSAPP_TOKEN=<meta_graph_api_long_running_token>
# Challenge token used in GET verification from Dashboard
WHATSAPP_VERIFY_TOKEN=whatsapp_local_webhook_secret_123
# Advanced SHA-256 payload integrity
WHATSAPP_APP_SECRET=<meta_app_secret_from_basic_settings>

# 5. Observability (Sentry.io)
SENTRY_DSN=https://<sentry_key>.ingest.us.sentry.io/<sentry_project_id>


# --- Frontend Configuration (.env.local via Next.js Vercel interface) ---
# NEXT_PUBLIC_SUPABASE_URL=https://<your_supabase_project_id>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon_key>
# NEXT_PUBLIC_API_URL=https://<your_fastapi_render_cluster>.onrender.com
